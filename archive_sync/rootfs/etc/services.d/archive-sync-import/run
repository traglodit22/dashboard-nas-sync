#!/usr/bin/with-contenv bash
set -euo pipefail

options=/data/options.json
service_url="$(jq -r '.service_url' "$options")"
token_file="$(jq -r '.token_file' "$options")"
import_enabled="$(jq -r '.import_enabled // false' "$options")"
import_root="$(jq -r '.import_root // "/share/NAS/apple-import"' "$options")"
import_parallel="$(jq -r '.import_parallel // 2' "$options")"
skip_videos="$(jq -r '.import_skip_videos // false' "$options")"
done_retention_days="$(jq -r '.import_done_retention_days // 30' "$options")"
mount_check_enabled="$(jq -r '.mount_check_enabled // true' "$options")"
import_probe_timeout="$(jq -r '.import_storage_probe_timeout_seconds // 30' "$options")"
import_fail_limit="$(jq -r '.import_storage_fail_limit // 3' "$options")"
retry_delay="$(jq -r '.retry_delay_seconds' "$options")"
import_dir_scan_timeout="$(jq -r '.import_dir_scan_timeout_seconds // 180' "$options")"
files_root="$(jq -r '.files_root // "/share/NAS"' "$options")"

if [[ "$import_enabled" != "true" ]]; then
  echo "[import] disabled (import_enabled != true)"
  exit 0
fi

echo "[import] service started: root=$import_root retry=${retry_delay}s"

export DASHBOARD_URL="$service_url"
export IMPORT_ROOT="$import_root"
export IMPORT_PARALLEL="$import_parallel"
export IMPORT_SKIP_VIDEOS="$skip_videos"
export IMPORT_DONE_RETENTION_DAYS="$done_retention_days"
export MOUNT_CHECK_ENABLED="$mount_check_enabled"
export IMPORT_STORAGE_PROBE_TIMEOUT_SECONDS="$import_probe_timeout"
export IMPORT_STORAGE_FAIL_LIMIT="$import_fail_limit"
export IMPORT_DIR_SCAN_TIMEOUT="$import_dir_scan_timeout"
# Корень галереи на NAS (тот же, что у file API): файлы переносятся туда на месте.
export FILES_ROOT="$files_root"
export IMPORT_STATE_FILE="/data/import-state.json"

read_token() {
  tr -d '\r\n' < "$token_file" 2>/dev/null || true
}

while true; do
  if [[ ! -s "$token_file" || -z "$service_url" ]]; then
    echo "[import] service URL or token file is missing"
    sleep "$retry_delay"
    continue
  fi
  export NAS_SYNC_TOKEN="$(read_token)"

  # Один потоковый проход по папке импорта (без предварительного find по дереву).
  # 3 — исчерпан бюджет времени, продолжаем сразу; 4 — работы не было, ждём дольше.
  echo "[import] media scan started"
  code=0
  /usr/local/bin/archive-import || code=$?
  case "$code" in
    0) echo "[import] media scan finished"; sleep "$retry_delay" ;;
    3) echo "[import] media scan paused (time budget); continuing" ;;
    4) echo "[import] nothing to import"; sleep $(( retry_delay > 300 ? retry_delay : 300 )) ;;
    *) echo "[import] media scan failed (exit=$code); retrying in ${retry_delay}s"; sleep "$retry_delay" ;;
  esac
done
