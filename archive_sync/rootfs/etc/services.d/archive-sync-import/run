#!/usr/bin/with-contenv bash
set -euo pipefail

options=/data/options.json
service_url="$(jq -r '.service_url' "$options")"
token_file="$(jq -r '.token_file' "$options")"
import_enabled="$(jq -r '.import_enabled // false' "$options")"
import_root="$(jq -r '.import_root // "/share/NAS/apple-import"' "$options")"
import_parallel="$(jq -r '.import_parallel // 2' "$options")"
retry_delay="$(jq -r '.retry_delay_seconds' "$options")"

if [[ "$import_enabled" != "true" ]]; then
  echo "[import] disabled (import_enabled != true)"
  exit 0
fi

export DASHBOARD_URL="$service_url"
export IMPORT_ROOT="$import_root"
export IMPORT_PARALLEL="$import_parallel"
export IMPORT_STATE_FILE="/data/import-state.json"

read_token() {
  tr -d '\r\n' < "$token_file" 2>/dev/null || true
}

while true; do
  if [[ ! -s "$token_file" || -z "$service_url" ]]; then
    echo "[import] service URL or token file is missing"
    sleep "$retry_delay"
    continue
  fi
  export NAS_SYNC_TOKEN="$(read_token)"

  # Automatically enrich media already moved to .done. The worker stores a
  # CSV fingerprint, so this is cheap on subsequent polling cycles.
  if ! /usr/local/bin/archive-import --metadata-backfill; then
    echo "[import] metadata backfill failed; retrying later"
  fi

  # Обрабатывает один архив за вызов; если архивов нет — выход 0.
  if /usr/local/bin/archive-import; then
    # Если архив был обработан — сразу берём следующий; если пусто — ждём.
    if [[ -f "$IMPORT_STATE_FILE" ]] && find "$IMPORT_ROOT" -maxdepth 1 -iname '*.zip' -print -quit 2>/dev/null | grep -q .; then
      continue
    fi
    sleep "$retry_delay"
  else
    echo "[import] failed; retrying in ${retry_delay}s"
    sleep "$retry_delay"
  fi
done
