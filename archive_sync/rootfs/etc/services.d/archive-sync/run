#!/usr/bin/with-contenv bash
set -euo pipefail

options=/data/options.json
service_url="$(jq -r '.service_url' "$options")"
token_file="$(jq -r '.token_file' "$options")"
worker_id="$(jq -r '.worker_id' "$options")"
category="$(jq -r '.category' "$options")"
batch_size="$(jq -r '.batch_size' "$options")"
destination_root="$(jq -r '.destination_root' "$options")"
retry_delay="$(jq -r '.retry_delay_seconds' "$options")"
auto_start="$(jq -r '.auto_start' "$options")"

mkdir -p /data
pending_command=""

write_state() {
  local status="$1" error="${2:-}"
  jq -n --arg status "$status" --arg error "$error" \
    '{status: $status, error: (if $error == "" then null else $error end), updatedAt: now | todateiso8601}' \
    > /data/state.json.tmp
  mv -f /data/state.json.tmp /data/state.json
}

poll_command() {
  local token
  token="$(tr -d '\r\n' < "$token_file" 2>/dev/null || true)"
  [[ -n "$token" && -n "$service_url" ]] || return 0
  curl --retry 6 --retry-delay 2 --retry-max-time 90 --fail --silent --show-error \
    -H "Authorization: Bearer $token" \
    -H "X-NAS-Agent-Id: $worker_id" \
    "$service_url/api/sync/nas/control?category=$category" \
    | jq -r '.command // empty'
}

report_status() {
  local status="$1" progress="${2:-}"
  local token
  token="$(tr -d '\r\n' < "$token_file" 2>/dev/null || true)"
  [[ -n "$token" && -n "$service_url" ]] || return 0
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $token" \
    -H "X-NAS-Agent-Id: $worker_id" \
    "$service_url/api/sync/nas/control?category=$category&status=$status${progress:+&progressDone=$progress}" >/dev/null || true
}

migrate_paths() {
  local cursor="" manifest item old_path new_path source target
  while :; do
    manifest="$(mktemp)"
    curl --retry 6 --retry-delay 2 --retry-max-time 90 --fail --silent --show-error \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $worker_id" \
      "$service_url/api/sync/nas/migration?limit=100${cursor:+&cursor=$(printf '%s' "$cursor" | jq -sRr @uri)}" > "$manifest" \
      || { rm -f "$manifest"; return 1; }
    while IFS=$'\t' read -r old_path new_path; do
      source="$destination_root/$old_path"
      target="$destination_root/$new_path"
      [[ -f "$source" ]] || continue
      if [[ -e "$target" ]]; then
        printf 'migration conflict, keeping old file: %s\n' "$old_path"
        continue
      fi
      mkdir -p "$(dirname "$target")"
      mv -- "$source" "$target"
      printf 'migrated %s -> %s\n' "$old_path" "$new_path"
    done < <(jq -r '.items[] | [.oldPath, .newPath] | @tsv' "$manifest")
    cursor="$(jq -r '.nextCursor // empty' "$manifest")"
    rm -f "$manifest"
    [[ -n "$cursor" ]] || break
  done
}

if [[ "$auto_start" != "true" ]]; then
  write_state idle
  echo "Archive sync is idle; start it from the service or enable auto_start"
  while true; do
    pending_command="$(poll_command || true)"
    [[ "$pending_command" == "start" || "$pending_command" == "migrate" ]] && break
    sleep 2
  done
fi

while true; do
  if [[ ! -s "$token_file" || -z "$service_url" ]]; then
    echo "Service URL or token file is missing"
    sleep "$retry_delay"
    continue
  fi

  export DASHBOARD_URL="$service_url"
  export NAS_SYNC_TOKEN="$(tr -d '\r\n' < "$token_file")"
  export NAS_SYNC_AGENT_ID="$worker_id"
  export NAS_SYNC_CATEGORY="$category"
  export NAS_SYNC_BATCH="$batch_size"
  export NAS_SYNC_ROOT="$destination_root"

  command="${pending_command:-$(poll_command || true)}"
  pending_command=""
  if [[ "$command" == "migrate" ]]; then
    write_state migrating
    report_status running 0
    if migrate_paths; then
      write_state completed
      report_status completed
      echo "Archive path migration completed"
    else
      write_state error "path migration failed"
      report_status error
      echo "Archive path migration failed"
    fi
    [[ "$auto_start" == "true" ]] || exit 0
    sleep "$retry_delay"
    continue
  fi

  write_state running
  report_status running 0
  /usr/local/bin/archive-sync &
  sync_pid=$!
  while kill -0 "$sync_pid" 2>/dev/null; do
    progress="$(jq -r '.synced // 0' /data/state.json 2>/dev/null || printf '0')"
    report_status running "$progress"
    command="$(poll_command || true)"
    if [[ "$command" == "stop" ]]; then
      kill -TERM "$sync_pid" 2>/dev/null || true
    elif [[ "$command" == "pause" ]]; then
      kill -STOP "$sync_pid" 2>/dev/null || true
    elif [[ "$command" == "resume" ]]; then
      kill -CONT "$sync_pid" 2>/dev/null || true
    fi
    sleep 2
  done
  set +e
  wait "$sync_pid"
  sync_rc=$?
  set -e
  if [[ "$sync_rc" == 0 ]]; then
    write_state completed
    report_status completed
    [[ "$auto_start" == "true" ]] || exit 0
    sleep "$retry_delay"
  else
    write_state error "sync failed with exit code $sync_rc"
    report_status error
    [[ "$auto_start" == "true" ]] || exit "$sync_rc"
    sleep "$retry_delay"
  fi
done
