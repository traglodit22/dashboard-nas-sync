#!/usr/bin/with-contenv bash
set -euo pipefail

options=/data/options.json
service_url="$(jq -r '.service_url' "$options")"
token_file="$(jq -r '.token_file' "$options")"
worker_id="$(jq -r '.worker_id' "$options")"
category="$(jq -r '.category' "$options")"
batch_size="$(jq -r '.batch_size' "$options")"
parallel_downloads="$(jq -r '.parallel_downloads // 4' "$options")"
destination_root="$(jq -r '.destination_root' "$options")"
retry_delay="$(jq -r '.retry_delay_seconds' "$options")"
auto_start="$(jq -r '.auto_start' "$options")"
backup_enabled="$(jq -r '.backup_enabled // false' "$options")"
backup_destination_root="$(jq -r '.backup_destination_root // "/share/NAS/backups"' "$options")"
backup_project_name="$(jq -r '.backup_project_name // "dashboard"' "$options")"
backup_projects_json="$(jq -r '.backup_projects_json // "[]"' "$options")"

mkdir -p /data

export DASHBOARD_URL="$service_url"
export NAS_SYNC_ROOT="$destination_root"
export NAS_SYNC_BATCH="$batch_size"
export NAS_BACKUP_ROOT="$backup_destination_root"
export NAS_BACKUP_PROJECT_NAME="$backup_project_name"

read_token() {
  tr -d '\r\n' < "$token_file" 2>/dev/null || true
}

poll_command() {
  local agent="$1" cat="$2" token
  token="$(read_token)"
  [[ -n "$token" && -n "$service_url" ]] || return 0
  curl --retry 6 --retry-delay 2 --retry-max-time 90 --fail --silent --show-error \
    -H "Authorization: Bearer $token" \
    -H "X-NAS-Agent-Id: $agent" \
    "$service_url/api/sync/nas/control?category=$cat" \
    | jq -r '.command // empty'
}

report_status() {
  local agent="$1" cat="$2" status="$3" progress="${4:-}" token
  token="$(read_token)"
  [[ -n "$token" && -n "$service_url" ]] || return 0
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $token" \
    -H "X-NAS-Agent-Id: $agent" \
    "$service_url/api/sync/nas/control?category=$cat&status=$status${progress:+&progressDone=$progress}" >/dev/null || true
}

migrate_paths() {
  local agent="$1" cursor="" manifest item old_path new_path source target
  while :; do
    manifest="$(mktemp)"
    curl --retry 6 --retry-delay 2 --retry-max-time 90 --fail --silent --show-error \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $agent" \
      "$service_url/api/sync/nas/migration?limit=100${cursor:+&cursor=$(printf '%s' "$cursor" | jq -sRr @uri)}" > "$manifest" \
      || { rm -f "$manifest"; return 1; }
    while IFS=$'\t' read -r old_path new_path; do
      source="$destination_root/$old_path"
      target="$destination_root/$new_path"
      [[ -f "$source" ]] || continue
      if [[ -e "$target" ]]; then
        printf 'migration conflict, keeping old file: %s\n' "$old_path"
        continue
      fi
      mkdir -p "$(dirname "$target")"
      mv -- "$source" "$target"
      printf 'migrated %s -> %s\n' "$old_path" "$new_path"
    done < <(jq -r '.items[] | [.oldPath, .newPath] | @tsv' "$manifest")
    cursor="$(jq -r '.nextCursor // empty' "$manifest")"
    rm -f "$manifest"
    [[ -n "$cursor" ]] || break
  done
}

sync_extra_project_backups() {
  local encoded project slug project_url project_token_file project_worker_id project_root project_token
  jq -e 'type == "array"' <<< "$backup_projects_json" >/dev/null || {
    echo "backup_projects_json must be a JSON array" >&2
    return 1
  }
  while IFS= read -r encoded; do
    project="$(printf '%s' "$encoded" | base64 -d)"
    slug="$(jq -r '.slug // empty' <<< "$project")"
    project_url="$(jq -r '.service_url // empty' <<< "$project")"
    project_token_file="$(jq -r '.token_file // empty' <<< "$project")"
    project_worker_id="$(jq -r '.worker_id // empty' <<< "$project")"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ && -n "$project_url" && -n "$project_token_file" && -n "$project_worker_id" ]] || {
      echo "Skipping invalid backup project configuration" >&2
      continue
    }
    project_token="$(tr -d '\r\n' < "$project_token_file" 2>/dev/null || true)"
    [[ -n "$project_token" ]] || { echo "Missing token for backup project $slug" >&2; continue; }
    project_root="$backup_destination_root"
    echo "Syncing backup project $slug"
    DASHBOARD_URL="$project_url" NAS_SYNC_TOKEN="$project_token" NAS_SYNC_AGENT_ID="$project_worker_id" \
      NAS_SYNC_ROOT="$destination_root" NAS_BACKUP_ENABLED=true NAS_BACKUP_ONLY=true \
      NAS_BACKUP_ROOT="$project_root" NAS_BACKUP_PROJECT_NAME="$slug" \
      NAS_SYNC_BATCH="$batch_size" /usr/local/bin/archive-sync
  done < <(jq -r '.[] | @base64' <<< "$backup_projects_json")
}

# Независимый воркер одной категории: свой agent id, свой state-файл,
# свой канал команд на дашборде. with_backups=true только у основного.
supervise_worker() {
  local w_category="$1" w_agent="$2" w_parallel="$3" w_state="$4" w_backups="$5"
  local command sync_pid sync_rc progress

  if [[ "$auto_start" != "true" ]]; then
    echo "[$w_category] idle; waiting for start command (agent $w_agent)"
    report_status "$w_agent" "$w_category" idle ""
    while true; do
      command="$(poll_command "$w_agent" "$w_category" || true)"
      [[ "$command" == "start" ]] && break
      [[ "$w_category" == "gallery" && "$command" == "migrate" ]] && break
      sleep 2
    done
  fi

  while true; do
    if [[ ! -s "$token_file" || -z "$service_url" ]]; then
      echo "[$w_category] service URL or token file is missing"
      sleep "$retry_delay"
      continue
    fi

    NAS_SYNC_TOKEN="$(read_token)"
    export NAS_SYNC_TOKEN

    command="$(poll_command "$w_agent" "$w_category" || true)"
    if [[ "$w_category" == "gallery" && "$command" == "migrate" ]]; then
      report_status "$w_agent" "$w_category" running 0
      if migrate_paths "$w_agent"; then
        report_status "$w_agent" "$w_category" completed ""
        echo "[gallery] path migration completed"
      else
        report_status "$w_agent" "$w_category" error ""
        echo "[gallery] path migration failed"
      fi
      [[ "$auto_start" == "true" ]] || return 0
      sleep "$retry_delay"
      continue
    fi

    if [[ "$w_backups" == "true" ]]; then
      if ! sync_extra_project_backups; then
        report_status "$w_agent" "$w_category" error ""
        echo "[$w_category] external backup projects failed; retrying in ${retry_delay}s"
        sleep "$retry_delay"
        continue
      fi
    fi

    report_status "$w_agent" "$w_category" running 0
    if [[ "$w_backups" == "true" ]]; then
      export NAS_BACKUP_ENABLED="$backup_enabled"
    else
      export NAS_BACKUP_ENABLED=false
    fi
    NAS_SYNC_CATEGORY="$w_category" \
    NAS_SYNC_AGENT_ID="$w_agent" \
    NAS_SYNC_PARALLEL="$w_parallel" \
    NAS_SYNC_STATE_FILE="$w_state" \
      /usr/local/bin/archive-sync &
    sync_pid=$!
    while kill -0 "$sync_pid" 2>/dev/null; do
      progress="$(jq -r '.synced // 0' "$w_state" 2>/dev/null || printf '0')"
      report_status "$w_agent" "$w_category" running "$progress"
      command="$(poll_command "$w_agent" "$w_category" || true)"
      case "$command" in
        stop)
          kill -CONT "$sync_pid" 2>/dev/null || true
          kill -TERM "$sync_pid" 2>/dev/null || true
          ;;
        pause)
          kill -STOP "$sync_pid" 2>/dev/null || true
          report_status "$w_agent" "$w_category" paused "$progress"
          ;;
        resume)
          kill -CONT "$sync_pid" 2>/dev/null || true
          ;;
      esac
      sleep 2
    done
    set +e
    wait "$sync_pid"
    sync_rc=$?
    set -e
    if [[ "$sync_rc" == 0 ]]; then
      report_status "$w_agent" "$w_category" completed ""
      echo "[$w_category] sync completed"
      [[ "$auto_start" == "true" ]] || return 0
      sleep "$retry_delay"
    else
      report_status "$w_agent" "$w_category" error ""
      echo "[$w_category] sync failed with exit code $sync_rc; retrying in ${retry_delay}s"
      # Once started, keep retrying transient failures instead of returning to idle.
      sleep "$retry_delay"
    fi
  done
}

# Заметки (cloud) на NAS-primary у Dashboard: воркер cloud-синка убран (v0.7.0).
supervise_worker "$category" "$worker_id" "$parallel_downloads" "/data/state-$category.json" "true" &
worker_pids="$!"

# shellcheck disable=SC2086
wait $worker_pids || true
