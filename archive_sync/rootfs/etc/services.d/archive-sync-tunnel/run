#!/usr/bin/with-contenv bash
# Reverse SSH tunnel: VPS loopback → file API этого add-on (порт 8099).
# Даёт Dashboard доступ к NAS-файлам, когда пользователь не в домашней сети.
# s6 перезапускает сервис при выходе; дополнительный backoff — внутри.
set -uo pipefail

options=/data/options.json
enabled="$(jq -r '.tunnel_enabled // false' "$options")"

if [[ "$enabled" != "true" ]]; then
  echo "NAS tunnel disabled (tunnel_enabled != true)"
  exec sleep infinity
fi

host="$(jq -r '.tunnel_host // empty' "$options")"
port="$(jq -r '.tunnel_port // 22' "$options")"
user="$(jq -r '.tunnel_user // "nas-tunnel"' "$options")"
remote_bind="$(jq -r '.tunnel_remote_bind // "127.0.0.1:18125"' "$options")"
private_key="$(jq -r '.tunnel_private_key // empty' "$options")"
key_file_opt="$(jq -r '.tunnel_key_file // empty' "$options")"

key_file=/data/tunnel_key

# Приоритет: файл с ключом на HA-хосте (надёжно, без YAML-эскейпинга).
if [[ -n "$key_file_opt" && -s "$key_file_opt" ]]; then
  cp "$key_file_opt" "$key_file"
  chmod 600 "$key_file"
  echo "NAS tunnel: ключ из файла $key_file_opt"
elif [[ -n "$private_key" ]]; then
  # Варианты порчи при вставке в YAML/форму: схлопнутые переводы строк,
  # литеральные "\n", обрамляющие кавычки. Нормализуем всё.
  normalized="$(printf '%s' "$private_key" \
    | sed 's/\\r\\n/\n/g; s/\\n/\n/g' \
    | sed 's/^["'"'"']//; s/["'"'"']$//')"
  printf '%s\n' "$normalized" > "$key_file"
  chmod 600 "$key_file"
  if ! ssh-keygen -y -f "$key_file" >/dev/null 2>&1; then
    # Пересборка PEM: срезаем маркеры, убираем все пробельные, wrap по 70.
    # printf '%s\n' гарантирует перевод строки перед END-маркером.
    body="$(printf '%s' "$normalized" \
      | sed 's/-----BEGIN OPENSSH PRIVATE KEY-----//; s/-----END OPENSSH PRIVATE KEY-----//' \
      | tr -d ' \r\n\t')"
    { echo '-----BEGIN OPENSSH PRIVATE KEY-----'
      printf '%s\n' "$body" | fold -w 70
      echo '-----END OPENSSH PRIVATE KEY-----'
    } > "$key_file"
    chmod 600 "$key_file"
  fi
else
  echo "NAS tunnel: ни tunnel_key_file, ни tunnel_private_key не заданы — сплю"
  exec sleep infinity
fi

if ! ssh-keygen -y -f "$key_file" >/dev/null 2>&1; then
  body_len="$(sed 's/-----[A-Z ]*-----//g' "$key_file" | tr -d ' \r\n\t' | wc -c)"
  echo "NAS tunnel: ключ невалиден (тело base64: ${body_len} символов, ожидается ~350)."
  echo "NAS tunnel: надёжный путь — положите ключ файлом в /config/nas-tunnel-key и задайте tunnel_key_file: /homeassistant/nas-tunnel-key"
  exec sleep infinity
fi

if [[ -z "$host" ]]; then
  echo "NAS tunnel: tunnel_host не задан — сплю"
  exec sleep infinity
fi

echo "NAS tunnel: ${remote_bind} на ${host} → 127.0.0.1:8099"

while true; do
  ssh -N -T \
    -i "$key_file" \
    -o IdentitiesOnly=yes \
    -o BatchMode=yes \
    -o PreferredAuthentications=publickey \
    -o StrictHostKeyChecking=accept-new \
    -o ServerAliveInterval=20 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o ConnectTimeout=15 \
    -p "$port" \
    -R "${remote_bind}:127.0.0.1:8099" \
    "${user}@${host}"
  echo "NAS tunnel: ssh вышел ($?), рестарт через 15с"
  sleep 15
done
