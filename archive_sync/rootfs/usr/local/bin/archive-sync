#!/usr/bin/env bash
set -euo pipefail

trap 'rc=$?; printf "archive sync shell error at line %s: %s (exit %s)\n" "$LINENO" "$BASH_COMMAND" "$rc" >&2; exit "$rc"' ERR

: "${DASHBOARD_URL:?service URL is required}"
: "${NAS_SYNC_TOKEN:?access token is required}"
: "${NAS_SYNC_AGENT_ID:=archive-sync-worker}"
: "${NAS_SYNC_ROOT:=/share/NAS}"
: "${NAS_SYNC_CATEGORY:=primary}"
: "${NAS_SYNC_BATCH:=100}"
: "${NAS_DOWNLOAD_TIMEOUT_SECONDS:=1800}"

download_with_resume() {
  local download_url="$1" destination="$2" attempt

  for attempt in 1 2 3; do
    if curl --fail --silent --show-error --location \
      --connect-timeout 30 \
      --max-time "$NAS_DOWNLOAD_TIMEOUT_SECONDS" \
      --retry 2 --retry-delay 5 --retry-connrefused \
      --continue-at - \
      "$download_url" --output "$destination"; then
      return 0
    fi
    printf 'download attempt %s failed for %s; resuming if possible\n' "$attempt" "$destination" >&2
  done

  printf 'download failed after retries: %s\n' "$destination" >&2
  return 1
}

sync_backups() {
  local manifest_url="${NAS_BACKUP_MANIFEST_URL:-${DASHBOARD_URL%/}/api/sync/nas/backups/manifest}"
  local complete_url="${NAS_BACKUP_COMPLETE_URL:-${DASHBOARD_URL%/}/api/sync/nas/backups/complete}"
  local root="${NAS_BACKUP_ROOT:-$NAS_SYNC_ROOT/backups}"
  local project="${NAS_BACKUP_PROJECT_NAME:-dashboard}"
  local manifest receipt run_id role key relative_path size_bytes md5_hex generation download_url destination temporary actual_size actual_md5 run_count
  mkdir -p "$root"
  while :; do
    manifest="$(mktemp)"
    receipt="$(mktemp)"
    curl "${curl_retry[@]}" --fail --silent --show-error \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
      "$manifest_url?limit=$NAS_SYNC_BATCH" > "$manifest" \
      || fail manifest "Backup request failed"
    jq -e '.schemaVersion == 1' "$manifest" >/dev/null || fail manifest "invalid backup schema"
    run_count="$(jq '.runs | length' "$manifest")"
    [[ "$run_count" -gt 0 ]] || { rm -f "$manifest" "$receipt"; break; }
    jq -n '{receipts: []}' > "$receipt"
    while IFS= read -r encoded_item; do
    item="$(printf '%s' "$encoded_item" | base64 -d)"
    run_id="$(jq -r '.runId // .run_id // empty' <<< "$item")"
    role="$(jq -r '.role // empty' <<< "$item")"
    key="$(jq -r '.key // empty' <<< "$item")"
    relative_path="$(jq -r '.relativePath // empty' <<< "$item")"
    size_bytes="$(jq -r '.sizeBytes // empty' <<< "$item")"
    md5_hex="$(jq -r '.md5Hex // empty' <<< "$item")"
    generation="$(jq -r '.gcsGeneration // empty' <<< "$item")"
    download_url="$(jq -r '.downloadUrl // empty' <<< "$item")"
    if [[ -z "$run_id" || -z "$role" || -z "$key" || -z "$relative_path" || -z "$download_url" ]]; then
      missing_fields=""
      [[ -n "$run_id" ]] || missing_fields+=" runId"
      [[ -n "$role" ]] || missing_fields+=" role"
      [[ -n "$key" ]] || missing_fields+=" key"
      [[ -n "$relative_path" ]] || missing_fields+=" relativePath"
      [[ -n "$download_url" ]] || missing_fields+=" downloadUrl"
      fail manifest "invalid backup item; missing:${missing_fields}"
    fi
    [[ "$relative_path" == "$project/"* ]] || fail manifest "backup project mismatch"
    destination="$root/$relative_path"
    mkdir -p "$(dirname "$destination")"
    temporary="${destination}.archive-sync.tmp.$$"
    rm -f "$temporary"
    if ! download_with_resume "$download_url" "$temporary"; then
      rm -f "$temporary"
      printf 'missing or unavailable object, skipping: %s\n' "$relative_path" >&2
      continue
    fi
    actual_size="$(stat -c '%s' "$temporary")"
    [[ "$actual_size" == "$size_bytes" ]] || { rm -f "$temporary"; fail size "$relative_path"; }
    actual_md5="$(md5sum "$temporary" | cut -d' ' -f1)"
    [[ -z "$md5_hex" || "$actual_md5" == "$md5_hex" ]] || { rm -f "$temporary"; fail hash "$relative_path"; }
    sync "$temporary"
    mv -f -- "$temporary" "$destination" || fail move "$relative_path"
    jq --arg runId "$run_id" --arg role "$role" --arg key "$key" --argjson sizeBytes "$actual_size" --arg md5Hex "$actual_md5" --arg generation "$generation" \
      '.receipts += [{runId: $runId, role: $role, key: $key, sizeBytes: $sizeBytes, md5Hex: $md5Hex, gcsGeneration: ($generation | if . == "" then null else . end)}]' "$receipt" > "${receipt}.next"
    mv -f "${receipt}.next" "$receipt"
    total=$((total + 1))
  done < <(jq -r '.runs[] | {run: ., object: .objects[]} | {runId: .run.runId, stamp: .run.stamp} + .object | @base64' "$manifest")
    if [[ "$(jq '.receipts | length' "$receipt")" -gt 0 ]]; then
    curl "${curl_retry[@]}" --fail --silent --show-error -X POST \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
      -H 'Content-Type: application/json' \
      --data-binary "@$receipt" "$complete_url" >/dev/null || fail complete "Backup receipt rejected"
    fi
    rm -f "$manifest" "$receipt"
  done
}

api="${DASHBOARD_URL%/}/api/sync/nas/manifest"
complete_api="${DASHBOARD_URL%/}/api/sync/nas/complete"
missing_api="${DASHBOARD_URL%/}/api/sync/nas/missing"
cursor=""
total=0
manifest=""
completion=""
missing=""
trap 'rm -f "$manifest" "$completion"' EXIT

curl_retry=(--retry 6 --retry-delay 2 --retry-max-time 90 --connect-timeout 20 --max-time 180)

fail() {
  printf 'archive sync failed at %s: %s\n' "$1" "$2" >&2
  exit 1
}

mkdir -p "$NAS_SYNC_ROOT"
printf '{"synced":0,"updatedAt":"%s"}\n' "$(date -u +%FT%TZ)" > /data/state.json 2>/dev/null || true

if [[ "${NAS_BACKUP_ENABLED:-false}" == "true" ]]; then
  printf 'syncing project backups before media files\n'
  if ! ( sync_backups ); then
    printf 'backup sync failed; continuing with media files\n' >&2
    printf '{"synced":0,"backupError":"backup sync failed","updatedAt":"%s"}\n' "$(date -u +%FT%TZ)" > /data/state.json 2>/dev/null || true
  fi
fi

if [[ "${NAS_BACKUP_ONLY:-false}" == "true" ]]; then
  exit 0
fi

while :; do
  url="$api?category=$(printf '%s' "$NAS_SYNC_CATEGORY" | jq -sRr @uri)&limit=$NAS_SYNC_BATCH"
  if [[ -n "$cursor" ]]; then
    url+="&cursor=$(printf '%s' "$cursor" | jq -sRr @uri)"
  fi
  manifest="$(mktemp)"
  printf 'requesting manifest (batch=%s)\n' "$NAS_SYNC_BATCH"
  curl "${curl_retry[@]}" --fail --silent --show-error \
    -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
    -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" "$url" > "$manifest" \
    || fail manifest "Dashboard request failed"
  count="$(jq '.items | length' "$manifest")"
  [[ "$count" -gt 0 ]] || break
  completion="$(mktemp)"
  missing="$(mktemp)"
  jq -n '{items: []}' > "$completion"
  jq -n '{items: []}' > "$missing"

  while IFS= read -r encoded_item; do
    item="$(printf '%s' "$encoded_item" | base64 -d)"
    file_id="$(jq -r '.fileId // empty' <<< "$item")"
    logical_path="$(jq -r '.logicalPath // empty' <<< "$item")"
    size_bytes="$(jq -r '.sizeBytes // empty' <<< "$item")"
    content_hash="$(jq -r '.contentHash // empty' <<< "$item")"
    download_url="$(jq -r '.downloadUrl // empty' <<< "$item")"
    [[ -n "$file_id" && -n "$logical_path" && -n "$download_url" ]] || fail manifest "invalid item"
    destination="$NAS_SYNC_ROOT/$logical_path"
    mkdir -p "$(dirname "$destination")"
    temporary="${destination}.archive-sync.tmp.$$"
    rm -f "$temporary"
    printf 'downloading %s (expected %s bytes)\n' "$logical_path" "$size_bytes"
    if ! download_with_resume "$download_url" "$temporary"; then
      rm -f "$temporary"
      printf 'missing or unavailable object, recording and skipping: %s\n' "$logical_path" >&2
      jq --arg fileId "$file_id" --arg reason "GCS download returned HTTP 404 or another terminal error" \
        '.items += [{fileId: $fileId, reason: $reason}]' "$missing" > "${missing}.next"
      mv -f "${missing}.next" "$missing"
      continue
    fi
    if ! actual_size="$(stat -c '%s' "$temporary")"; then
      rm -f "$temporary"
      fail size "cannot stat $logical_path"
    fi
    if [[ "$actual_size" != "$size_bytes" ]]; then
      rm -f "$temporary"
      fail size "$logical_path (expected $size_bytes, got $actual_size)"
    fi
    printf 'validated size for %s (%s bytes)\n' "$logical_path" "$actual_size"
    if [[ -n "$content_hash" ]]; then
      if ! actual_hash="$(sha256sum "$temporary" | cut -d' ' -f1)"; then
        rm -f "$temporary"
        fail hash "cannot hash $logical_path"
      fi
      if [[ "$actual_hash" != "$content_hash" ]]; then
        rm -f "$temporary"
        fail hash "$logical_path (expected $content_hash, got $actual_hash)"
      fi
      printf 'validated hash for %s\n' "$logical_path"
    fi
    if ! mv -f -- "$temporary" "$destination"; then
      rm -f "$temporary"
      fail move "$logical_path -> $destination"
    fi
    jq --arg fileId "$file_id" --argjson sizeBytes "$size_bytes" --arg contentHash "$content_hash" \
      '.items += [{fileId: $fileId, sizeBytes: $sizeBytes, contentHash: ($contentHash | if . == "" then null else . end)}]' "$completion" > "${completion}.next"
    mv -f "${completion}.next" "$completion"
    printf 'stored %s\n' "$logical_path"
    total=$((total + 1))
    printf '{"synced":%s,"updatedAt":"%s"}\n' "$total" "$(date -u +%FT%TZ)" > /data/state.json 2>/dev/null || true
  done < <(jq -r '.items[] | @base64' "$manifest")

  if [[ "$(jq '.items | length' "$completion")" -gt 0 ]]; then
    printf 'confirming downloaded files\n'
    response="$(curl "${curl_retry[@]}" --fail --silent --show-error -X POST \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
      -H 'Content-Type: application/json' --data-binary "@$completion" "$complete_api")"
    [[ "$(jq -r '.complete // false' <<< "$response")" == true ]] || fail complete "$response"
  fi
  if [[ "$(jq '.items | length' "$missing")" -gt 0 ]]; then
    printf 'recording unavailable objects\n'
    curl "${curl_retry[@]}" --fail --silent --show-error -X POST \
      -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
      -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
      -H 'Content-Type: application/json' --data-binary "@$missing" "$missing_api" >/dev/null \
      || fail missing "Could not record unavailable objects"
  fi
  cursor="$(jq -r '.nextCursor // empty' "$manifest")"
  [[ -n "$cursor" ]] || break
done
