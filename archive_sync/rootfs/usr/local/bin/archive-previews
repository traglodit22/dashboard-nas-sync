#!/usr/bin/env python3
"""Превью галереи и длительность видео — локально на NAS (gallery-previews-on-nas).

Берёт у дашборда очередь (GET /api/sync/nas/previews), строит WebP той же геометрии,
что сервер (≤320 px, качество 80): фото — vipsthumbnail (HEIC через libheif),
видео — кадр ffmpeg + ffprobe (длительность, дата съёмки). На сервер уходит только
готовое превью (~20 КБ), оригиналы остаются на NAS.

Коды выхода: 0 — пачка обработана (продолжать), 4 — очередь пуста, 1 — ошибка.
"""
from __future__ import annotations

import base64
import concurrent.futures
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

DASHBOARD_URL = os.environ.get("DASHBOARD_URL", "").strip().rstrip("/")
TOKEN = os.environ.get("NAS_SYNC_TOKEN", "").strip()
FILES_ROOT = os.path.realpath(os.environ.get("FILES_ROOT", "/share/NAS").strip() or "/share/NAS")
PARALLEL = max(1, min(8, int(os.environ.get("PREVIEWS_PARALLEL", "4") or 4)))
BATCH = 50
PREVIEW_PX = 320
QUALITY = 80
TOOL_TIMEOUT = 120
EXIT_OK, EXIT_FAIL, EXIT_IDLE = 0, 1, 4


def log(msg: str) -> None:
    print(f"[previews] {msg}", flush=True)


def api(method: str, path: str, body: dict | None = None, timeout: int = 120):
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {"Authorization": f"Bearer {TOKEN}", "X-NAS-Agent-Id": "archive-previews"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    for attempt in range(3):
        req = urllib.request.Request(f"{DASHBOARD_URL}{path}", data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
                return resp.status, (json.loads(raw) if raw else None)
        except urllib.error.HTTPError as exc:
            if exc.code not in (502, 504):
                return exc.code, None
        except (urllib.error.URLError, OSError, ValueError):
            pass
        time.sleep(3 * (attempt + 1))
    return 0, None


def safe_path(rel: str) -> str | None:
    full = os.path.realpath(os.path.join(FILES_ROOT, rel))
    return full if full.startswith(FILES_ROOT + os.sep) else None


def run(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(["nice", "-n", "10", *cmd], capture_output=True, timeout=TOOL_TIMEOUT)


def photo_preview(path: str) -> bytes:
    with tempfile.TemporaryDirectory() as tmp:
        # vips читает файл с сетевого шара вразнобой — минуты на снимок; последовательная
        # копия в /tmp занимает доли секунды, сама миниатюра — мгновенно.
        src = os.path.join(tmp, "src" + os.path.splitext(path)[1].lower())
        shutil.copyfile(path, src)
        out = os.path.join(tmp, "p.webp")
        res = thumbnail(src, out)
        if (res.returncode != 0 or not os.path.exists(out)) and src.endswith((".heic", ".heif")):
            # vips из базового образа не всегда открывает HEIC с iPhone — через heif-convert в JPEG.
            first_error = res.stderr.decode(errors="replace").strip()
            jpg = os.path.join(tmp, "src.jpg")
            conv = run(["heif-convert", "-q", "90", src, jpg])
            if conv.returncode == 0 and os.path.exists(jpg):
                res = thumbnail(jpg, out)
            else:
                note_error("heif-convert", conv.stderr.decode(errors="replace") or first_error)
        if res.returncode != 0 or not os.path.exists(out):
            err = res.stderr.decode(errors="replace").strip()
            note_error("vipsthumbnail", err)
            raise RuntimeError(f"vipsthumbnail: {err[-300:]}")
        with open(out, "rb") as fh:
            return fh.read()


def thumbnail(src: str, out: str) -> subprocess.CompletedProcess:
    return run(["vipsthumbnail", src, "--size", f"{PREVIEW_PX}x{PREVIEW_PX}", "-o", f"{out}[Q={QUALITY}]"])


_logged: set[str] = set()


def note_error(tool: str, stderr: str) -> None:
    """Первую ошибку каждого инструмента — целиком в журнал add-on (для разбора)."""
    if tool in _logged:
        return
    _logged.add(tool)
    log(f"{tool} error (first): {stderr.strip()[:1500]}")


def video_probe(path: str) -> tuple[float | None, str | None]:
    res = run(["ffprobe", "-v", "error", "-show_entries", "format=duration:format_tags=creation_time",
               "-of", "json", path])
    if res.returncode != 0:
        return None, None
    fmt = (json.loads(res.stdout or b"{}").get("format") or {})
    try:
        duration = float(fmt.get("duration"))
    except (TypeError, ValueError):
        duration = None
    created = (fmt.get("tags") or {}).get("creation_time")
    return duration, created


def video_preview(path: str, duration: float | None) -> bytes:
    seek = min(1.0, duration / 2) if duration else 0.0
    res = run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-ss", f"{seek:.2f}", "-i", path,
               "-frames:v", "1", "-vf",
               f"scale={PREVIEW_PX}:{PREVIEW_PX}:force_original_aspect_ratio=decrease",
               "-f", "webp", "-quality", str(QUALITY), "pipe:1"])
    if res.returncode != 0 or not res.stdout:
        raise RuntimeError(f"ffmpeg: {res.stderr.decode(errors='replace')[:200]}")
    return res.stdout


def handle(job: dict) -> dict:
    result = {"fileId": job["fileId"], "ok": False}
    path = safe_path(job.get("nasPath") or "")
    if not path or not os.path.isfile(path):
        result["error"] = "file not found on NAS"
        return result
    try:
        if str(job.get("mime", "")).startswith("video/"):
            duration, created = video_probe(path)
            if duration:
                result["durationSec"] = round(duration, 2)
            if created:
                result["capturedAt"] = created
            if job.get("needPreview"):
                result["webpBase64"] = base64.b64encode(video_preview(path, duration)).decode("ascii")
        elif job.get("needPreview"):
            result["webpBase64"] = base64.b64encode(photo_preview(path)).decode("ascii")
        result["ok"] = True
    except Exception as exc:  # noqa: BLE001 — сообщаем серверу, он отложит повтор
        result["error"] = str(exc)[:300]
    return result


def main() -> int:
    if not DASHBOARD_URL or not TOKEN:
        log("DASHBOARD_URL and NAS_SYNC_TOKEN are required")
        return EXIT_FAIL
    status, body = api("GET", f"/api/sync/nas/previews?limit={BATCH}")
    if status == 404:
        log("dashboard has no /api/sync/nas/previews yet")
        return EXIT_IDLE
    if status != 200 or not isinstance(body, dict):
        log(f"queue request failed (HTTP {status})")
        return EXIT_FAIL
    jobs = body.get("jobs") or []
    if not jobs:
        log(f"queue empty (remaining {body.get('remaining')})")
        return EXIT_IDLE
    started = time.time()
    with concurrent.futures.ThreadPoolExecutor(PARALLEL) as pool:
        results = list(pool.map(handle, jobs))
    status, reply = api("POST", "/api/sync/nas/previews", {"results": results})
    ok = sum(1 for r in results if r["ok"])
    log(f"batch {len(jobs)}: ok={ok} failed={len(jobs) - ok} saved={((reply or {}).get('saved'))} "
        f"in {time.time() - started:.0f}s, remaining≈{body.get('remaining')} (HTTP {status})")
    return EXIT_OK if status == 200 else EXIT_FAIL


if __name__ == "__main__":
    sys.exit(main())
