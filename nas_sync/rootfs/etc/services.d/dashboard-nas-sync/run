#!/usr/bin/with-contenv bash
set -euo pipefail

options=/data/options.json
dashboard_url="$(jq -r '.dashboard_url' "$options")"
token_file="$(jq -r '.token_file' "$options")"
agent_id="$(jq -r '.agent_id' "$options")"
category="$(jq -r '.category' "$options")"
batch_size="$(jq -r '.batch_size' "$options")"
destination_root="$(jq -r '.destination_root' "$options")"
retry_delay="$(jq -r '.retry_delay_seconds' "$options")"
auto_start="$(jq -r '.auto_start' "$options")"

mkdir -p /data
rm -f /data/control
export NAS_SYNC_TOKEN_FILE="$token_file"
export DASHBOARD_URL="$dashboard_url"
export NAS_SYNC_TOKEN="$(tr -d '\r\n' < "$token_file" 2>/dev/null || true)"
export NAS_SYNC_AGENT_ID="$agent_id"
dashboard-nas-sync-api &

write_state() {
  local status="$1" error="${2:-}"
  jq -n --arg status "$status" --arg error "$error" \
    '{status: $status, error: (if $error == "" then null else $error end), updatedAt: now | todateiso8601}' \
    > /data/state.json.tmp
  mv -f /data/state.json.tmp /data/state.json
}

poll_command() {
  NAS_SYNC_TOKEN="$(tr -d '\r\n' < "$token_file" 2>/dev/null || true)"
  export NAS_SYNC_TOKEN
  [[ -n "$NAS_SYNC_TOKEN" ]] || return 0
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
    -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
    "$DASHBOARD_URL/api/sync/nas/control?category=$category" \
    | jq -r '.command // empty'
}

report_status() {
  local status="$1"
  local progress="$(jq -r '.synced // 0' /data/state.json 2>/dev/null || printf '0')"
  curl --fail --silent --show-error \
    -H "Authorization: Bearer $NAS_SYNC_TOKEN" \
    -H "X-NAS-Agent-Id: $NAS_SYNC_AGENT_ID" \
    "$DASHBOARD_URL/api/sync/nas/control?category=$category&status=$status&progressDone=$progress" >/dev/null || true
}

if [[ "$auto_start" != "true" ]]; then
  write_state idle
  report_status idle
  echo "NAS sync is idle; start it from Dashboard or enable auto_start"
  while true; do
    command="$(poll_command || true)"
    if [[ "$command" == "start" ]] || { [[ -f /data/control ]] && [[ "$(cat /data/control)" == "start" ]]; }; then
      rm -f /data/control
      break
    fi
    sleep 2
  done
fi

while true; do
  if [[ ! -s "$token_file" ]]; then
    echo "Dashboard token file is missing or empty: $token_file"
    sleep "$retry_delay"
    continue
  fi

  export DASHBOARD_URL="$dashboard_url"
  export NAS_SYNC_TOKEN="$(tr -d '\r\n' < "$token_file")"
  export NAS_SYNC_AGENT_ID="$agent_id"
  export NAS_SYNC_CATEGORY="$category"
  export NAS_SYNC_BATCH="$batch_size"
  export NAS_SYNC_ROOT="$destination_root"

  if [[ -f /data/control ]] && [[ "$(cat /data/control)" == "stop" ]]; then
    rm -f /data/control
    echo "NAS sync stopped"
    exit 0
  fi
  write_state running
  report_status running
  stop_requested=false
  /usr/local/bin/nas-sync.sh &
  sync_pid=$!
  while kill -0 "$sync_pid" 2>/dev/null; do
    command="$(poll_command || true)"
    if [[ -n "$command" ]]; then printf '%s' "$command" > /data/control; fi
    if [[ -f /data/control ]]; then
      command="$(cat /data/control)"
      if [[ "$command" == "pause" ]]; then
        write_state paused
        kill -STOP "$sync_pid"
        rm -f /data/control
      elif [[ "$command" == "resume" ]]; then
        kill -CONT "$sync_pid" 2>/dev/null || true
        write_state running
        rm -f /data/control
      elif [[ "$command" == "stop" ]]; then
        stop_requested=true
        kill -CONT "$sync_pid" 2>/dev/null || true
        kill -TERM "$sync_pid" 2>/dev/null || true
        rm -f /data/control
      fi
    fi
    sleep 2
  done
  set +e
  wait "$sync_pid"
  sync_rc=$?
  set -e
  if [[ "$sync_rc" == 0 ]]; then
    write_state completed
    report_status completed
    echo "NAS sync completed"
    if [[ "$auto_start" != "true" ]]; then
      while true; do
        if [[ -f /data/control ]] && [[ "$(cat /data/control)" == "start" ]]; then
          rm -f /data/control
          break
        fi
        sleep 2
      done
    else
      sleep "$retry_delay"
    fi
  else
    code="$sync_rc"
    if [[ "$stop_requested" == true ]]; then
      write_state idle
      report_status idle
      if [[ "$auto_start" != "true" ]]; then
        while true; do
          command="$(poll_command || true)"
          if [[ "$command" == "start" ]]; then
            rm -f /data/control
            break
          fi
          sleep 2
        done
        continue
      fi
    fi
    write_state error "sync failed with exit code $code"
    report_status error
    echo "NAS sync failed with exit code $code; retrying in ${retry_delay}s"
    if [[ "$auto_start" == "true" ]]; then sleep "$retry_delay"; else exit "$code"; fi
  fi
done
